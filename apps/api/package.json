{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --require dotenv/config src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude='**/bookings.integration.spec.ts' --exclude='**/bookings.concurrency.spec.ts' --exclude='**/app.e2e.spec.ts'",
    "test:integration": "vitest run src/bookings/bookings.integration.spec.ts src/bookings/bookings.concurrency.spec.ts",
    "test:e2e": "vitest run src/app.e2e.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@repo/database": "workspace:*",
    "@upstash/redis": "^1.38.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "helmet": "^8.1.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "^4.1.5"
  }
}
